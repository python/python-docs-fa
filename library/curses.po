msgstr "پایین سمت چپ صفحه‌کلید عددی"

msgid "Lower right of keypad"
msgstr "پایین سمت راست صفحه‌کلید عددی"

msgid "Back tab"
msgstr "تب معکوس (Back tab)"

msgid "Beg (beginning)"
msgstr "Beg (آغاز)"

msgid "Cancel"
msgstr "لغو"

msgid "Close"
msgstr "بستن"

msgid "Cmd (command)"
msgstr "Cmd (فرمان)"

msgid "Copy"
msgstr "کپی"

msgid "Create"
msgstr "ایجاد"

msgid "End"
msgstr "پایان"

msgid "Exit"
msgstr "خروج"

msgid "Find"
msgstr "یافتن"

msgid "Help"
msgstr "راهنما"

msgid "Mark"
msgstr "نشانه"

msgid "Message"
msgstr "پیام"

msgid "Move"
