msgstr "ثابت کلید"

msgid "Key"
msgstr "کلید"

msgid "Minimum key value"
msgstr "کمینه مقدار کلید"

msgid "Break key (unreliable)"
msgstr "کلید Break (غیرقابل‌اعتماد)"

msgid "Down-arrow"
msgstr "فلش پایین"

msgid "Up-arrow"
msgstr "فلش بالا"

msgid "Left-arrow"
msgstr "پیکان چپ"

msgid "Right-arrow"
msgstr "فلش راست"

msgid "Home key (upward+left arrow)"
msgstr "کلید Home (فلش بالا+چپ)"

msgid "Backspace (unreliable)"
msgstr "پس‌بر (غیرقابل‌اطمینان)"

msgid "Function keys.  Up to 64 function keys are supported."
msgstr "کلیدهای تابعی. تا ۶۴ کلید تابعی پشتیبانی می‌شود."

msgid "Value of function key *n*"
msgstr "مقدار کلید تابعی *n*"

msgid "Delete line"
msgstr "حذف خط"

msgid "Insert line"
msgstr "درج خط"

msgid "Delete character"
msgstr "نویسه‌ی حذف"

msgid "Insert char or enter insert mode"
msgstr "درج نویسه یا ورود به حالت درج"

msgid "Exit insert char mode"
msgstr "خروج از حالت درج نویسه"

msgid "Clear screen"
msgstr "پاک‌کردن صفحه"

msgid "Clear to end of screen"
msgstr "پاک کردن تا انتهای صفحه"

msgid "Clear to end of line"
msgstr "پاک‌سازی تا انتهای خط"

msgid "Scroll 1 line forward"
msgstr "پیمایش ۱ خط به جلو"

msgid "Scroll 1 line backward (reverse)"
msgstr "پیمایش ۱ خط به عقب (معکوس)"

msgid "Next page"
msgstr "صفحه بعدی"

msgid "Previous page"
msgstr "صفحه قبلی"

msgid "Set tab"
msgstr "تنظیم زبانه"

msgid "Clear tab"
msgstr "پاک‌کردن زبانه"

msgid "Clear all tabs"
msgstr "پاک کردن همه زبانه‌ها"

msgid "Enter or send (unreliable)"
msgstr "Enter یا ارسال (غیرقابل‌اعتماد)"

msgid "Soft (partial) reset (unreliable)"
msgstr "بازنشانی نرم (جزئی) (غیرقابل‌اطمینان)"

msgid "Reset or hard reset (unreliable)"
msgstr "بازنشانی یا بازنشانی سخت (غیرقابل‌اطمینان)"

msgid "Print"
msgstr "چاپ"

msgid "Home down or bottom (lower left)"
msgstr "Home down یا bottom (پایین سمت چپ)"

msgid "Upper left of keypad"
msgstr "بالا سمت چپ صفحه‌کلید"

msgid "Upper right of keypad"
msgstr "بالا سمت راست صفحه‌کلید"

msgid "Center of keypad"
msgstr "مرکز صفحه‌کلید عددی"

