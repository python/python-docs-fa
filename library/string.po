msgid ":mod:`!string` --- Common string operations"
msgstr ""

msgid "**Source code:** :source:`Lib/string/__init__.py`"
msgstr ""

msgid ":ref:`textseq`"
msgstr ""

msgid ":ref:`string-methods`"
