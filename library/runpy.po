msgstr ":ref:`using-on-general` - جزئیات خط فرمان CPython"

msgid "The :func:`importlib.import_module` function"
msgstr "تابع :func:`importlib.import_module`"

msgid "module"
msgstr "ماژول"

msgid "__main__"
msgstr "__main__"
