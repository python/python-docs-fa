msgstr "راه‌اندازی یک زیرفرایند."

msgid ":meth:`loop.subprocess_shell`"
msgstr ":meth:`loop.subprocess_shell`"

msgid "Spawn a subprocess from a shell command."
msgstr "راه‌اندازی یک زیرفرایند از طریق یک دستور پوسته."

