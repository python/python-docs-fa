msgstr "کد نوع"

msgid "C Type"
msgstr "نوع C"

msgid "Python Type"
msgstr "نوع پایتون"

msgid "Minimum size in bytes"
msgstr "حداقل اندازه به بایت"

msgid "Notes"
msgstr "یادداشت‌ها"

