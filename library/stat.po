msgstr "سوکت."

msgid "Symbolic link."
msgstr "پیوند نمادین."

msgid "Regular file."
msgstr "فایل معمولی."

msgid "Block device."
msgstr "دستگاه بلوکی."

msgid "Directory."
msgstr "پوشه."

msgid "Character device."
msgstr "دستگاه نویسه‌ای."

msgid "FIFO."
msgstr "FIFO."

msgid "Door."
msgstr "در."

msgid "Event port."
msgstr "پورت رویداد."

msgid "Whiteout."
msgstr "سفیدی مطلق (Whiteout)."

msgid ""
":data:`S_IFDOOR`, :data:`S_IFPORT` or :data:`S_IFWHT` are defined as 0 when "
