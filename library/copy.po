msgstr "__copy__() (پروتکل کپی)"

msgid "__deepcopy__() (copy protocol)"
msgstr "__deepcopy__() (پروتکل کپی)"

msgid "__replace__() (replace protocol)"
msgstr "__replace__() (پروتکل جایگزینی)"
