msgstr ":opcode:`!BINARY_*`"

msgid ":opcode:`!INPLACE_*`"
msgstr ":opcode:`!INPLACE_*`"

msgid ":opcode:`BINARY_OP`"
msgstr ":opcode:`BINARY_OP`"

