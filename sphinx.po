msgstr "دریافت امضای سازنده برای %s شکست خورد: %s"

#, python-format
msgid "Bases: %s"
msgstr "پایه‌ها: %s"

#, python-format
msgid "missing attribute %s in object %s"
msgstr "ویژگی گم‌شده‌ی %s در شیء %s"

