msgid "%s is not a directory."
msgstr "%s یک پوشه نیست."

msgid "Running apidoc"
msgstr "در حال اجرای apidoc"

#, python-format
msgid "apidoc_modules item %i must be a dict"
msgstr "آیتم %i در apidoc_modules باید یک دیکشنری باشد"

#, python-format
msgid "apidoc_modules item %i must have a 'path' key"
msgstr "آیتم %i در apidoc_modules باید کلید «path» داشته باشد"

#, python-format
msgid "apidoc_modules item %i 'path' must be a string"
msgstr "«path» در آیتم %i از apidoc_modules باید یک رشته باشد"

#, python-format
msgid "apidoc_modules item %i 'path' is not an existing folder: %s"
msgstr "«path» در آیتم %i از apidoc_modules یک پوشه‌ی موجود نیست: %s"

#, python-format
msgid "apidoc_modules item %i must have a 'destination' key"
msgstr "آیتم %i در apidoc_modules باید کلید «destination» داشته باشد"

#, python-format
msgid "apidoc_modules item %i 'destination' must be a string"
msgstr "«destination» در آیتم %i از apidoc_modules باید یک رشته باشد"

