msgstr "(در %s نسخه‌ی %s)"

#, python-format
msgid "(in %s)"
msgstr "(در %s)"

#, python-format
msgid "inventory '%s': duplicate matches found for %s:%s"
msgstr "فهرست موجودی «%s»: تطبیق‌های تکراری برای %s:%s پیدا شد"

#, python-format
msgid "inventory '%s': multiple matches found for %s:%s"
msgstr "فهرست موجودی «%s»: چندین تطبیق برای %s:%s پیدا شد"

#, python-format
msgid "inventory for external cross-reference not found: %r"
msgstr "فهرست موجودی برای ارجاع‌متقابل خارجی پیدا نشد: %r"

#, python-format
msgid "invalid external cross-reference suffix: %r"
msgstr "پسوند ارجاع‌متقابل خارجی نامعتبر: %r"

#, python-format
msgid "domain for external cross-reference not found: %r"
msgstr "دامنه برای ارجاع‌متقابل خارجی پیدا نشد: %r"

#, python-format
msgid "external %s:%s reference target not found: %s"
msgstr "هدف ارجاع خارجی %s:%s پیدا نشد: %s"

#, python-format
msgid "Invalid intersphinx project identifier `%r` in intersphinx_mapping. Project identifiers must be non-empty strings."
msgstr "شناسه‌ی پروژه‌ی intersphinx نامعتبر «%r» در intersphinx_mapping. شناسه‌های پروژه باید رشته‌های غیرخالی باشند."

#, python-format
msgid "Invalid value `%r` in intersphinx_mapping[%r]. Expected a two-element tuple or list."
msgstr "مقدار نامعتبر «%r» در intersphinx_mapping[%r]. یک تاپل یا فهرست دوعضوی انتظار می‌رفت."

#, python-format
msgid "Invalid value `%r` in intersphinx_mapping[%r]. Values must be a (target URI, inventory locations) pair."
msgstr "مقدار نامعتبر «%r» در intersphinx_mapping[%r]. مقادیر باید یک جفت (URI هدف، مکان‌های فهرست موجودی) باشند."

#, python-format
msgid "Invalid target URI value `%r` in intersphinx_mapping[%r][0]. Target URIs must be unique non-empty strings."
msgstr "مقدار URI هدف نامعتبر «%r» در intersphinx_mapping[%r][0]. URIهای هدف باید رشته‌های غیرخالی یکتا باشند."

#, python-format
msgid "Invalid target URI value `%r` in intersphinx_mapping[%r][0]. Target URIs must be unique (other instance in intersphinx_mapping[%r])."
msgstr "مقدار URI هدف نامعتبر «%r» در intersphinx_mapping[%r][0]. URIهای هدف باید یکتا باشند (نمونه‌ی دیگر در intersphinx_mapping[%r])."

#, python-format
msgid "Invalid inventory location value `%r` in intersphinx_mapping[%r][1]. Inventory locations must be non-empty strings or None."
msgstr "مقدار مکان فهرست موجودی نامعتبر «%r» در intersphinx_mapping[%r][1]. مکان‌های فهرست موجودی باید رشته‌های غیرخالی یا None باشند."

msgid "Invalid `intersphinx_mapping` configuration (1 error)."
msgstr "پیکربندی «intersphinx_mapping» نامعتبر (۱ خطا)."

#, python-format
msgid "Invalid `intersphinx_mapping` configuration (%s errors)."
msgstr "پیکربندی «intersphinx_mapping» نامعتبر (%s خطا)."

msgid "An invalid intersphinx_mapping entry was added after normalisation."
msgstr "یک ورودی نامعتبر intersphinx_mapping پس از نرمال‌سازی افزوده شد."

#, python-format
msgid "loading intersphinx inventory '%s' from %s ..."
msgstr "در حال بارگذاری فهرست موجودی intersphinx با نام «%s» از %s ..."

msgid "encountered some issues with some of the inventories, but they had working alternatives:"
msgstr "با برخی از فهرست‌های موجودی مشکلاتی برخورد شد، اما جایگزین‌های کارآمدی داشتند:"

msgid "failed to reach any of the inventories with the following issues:"
msgstr "دسترسی به هیچ‌کدام از فهرست‌های موجودی با مشکلات زیر ممکن نشد:"

#, python-format
msgid "intersphinx inventory has moved: %s -> %s"
msgstr "فهرست موجودی intersphinx جابه‌جا شده است: %s -> %s"

#, python-format
msgid "invalid value for member-order option: %s"
msgstr "مقدار نامعتبر برای گزینه‌ی member-order: %s"

#, python-format
msgid "invalid value for class-doc-from option: %s"
msgstr "مقدار نامعتبر برای گزینه‌ی class-doc-from: %s"

#, python-format
msgid "invalid signature for auto%s (%r)"
msgstr "امضای نامعتبر برای auto%s (%r)"

#, python-format
