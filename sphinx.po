msgstr "خطا هنگام قالب‌بندی آرگومان‌ها برای %s: %s"

#, python-format
msgid ""
"autodoc: failed to determine %s.%s (%r) to be documented, the following exception was raised:\n"
"%s"
msgstr ""
"autodoc: تعیین %s.%s (%r) برای مستندسازی شکست خورد، استثنای زیر پرتاب شد:\n"
"%s"

#, python-format
msgid "don't know which module to import for autodocumenting %r (try placing a \"module\" or \"currentmodule\" directive in the document, or giving an explicit module name)"
msgstr "مشخص نیست کدام ماژول برای مستندسازی خودکار %r باید ایمپورت شود (سعی کنید دایرکتیو «module» یا «currentmodule» را در سند قرار دهید، یا نام ماژول را صریحاً بدهید)"

#, python-format
msgid "A mocked object is detected: %r"
msgstr "شیء ماک‌شده‌ای شناسایی شد: %r"

#, python-format
msgid "error while formatting signature for %s: %s"
msgstr "خطا هنگام قالب‌بندی امضا برای %s: %s"

msgid "\"::\" in automodule name doesn't make sense"
msgstr "«::» در نام automodule معنایی ندارد"

#, python-format
msgid "signature arguments or return annotation given for automodule %s"
msgstr "آرگومان‌های امضا یا حاشیه‌نویسی بازگشتی برای automodule با نام %s داده شده است"

#, python-format
msgid "__all__ should be a list of strings, not %r (in module %s) -- ignoring __all__"
msgstr "‎__all__ باید فهرستی از رشته‌ها باشد، نه %r (در ماژول %s) -- ‎__all__ نادیده گرفته شد"

#, python-format
msgid "missing attribute mentioned in :members: option: module %s, attribute %s"
msgstr "ویژگی گم‌شده که در گزینه‌ی :members: ذکر شده: ماژول %s، ویژگی %s"

#, python-format
msgid "Failed to get a function signature for %s: %s"
msgstr "دریافت امضای تابع برای %s شکست خورد: %s"

#, python-format
