msgstr "«destination» در آیتم %i از apidoc_modules باید یک مسیر نسبی باشد"

#, python-format
msgid "apidoc_modules item %i cannot create destination directory: %s"
msgstr "آیتم %i از apidoc_modules نمی‌تواند پوشه‌ی مقصد بسازد: %s"

#, python-format
msgid "apidoc_modules item %i '%s' must be an int"
msgstr "آیتم %i از apidoc_modules، «%s» باید یک عدد صحیح باشد"

#, python-format
msgid "apidoc_modules item %i '%s' must be a boolean"
msgstr "آیتم %i از apidoc_modules، «%s» باید یک بولی باشد"

#, python-format
msgid "apidoc_modules item %i has unexpected keys: %s"
msgstr "آیتم %i از apidoc_modules کلیدهای غیرمنتظره‌ای دارد: %s"

#, python-format
msgid "apidoc_modules item %i '%s' must be a sequence"
msgstr "آیتم %i از apidoc_modules، «%s» باید یک دنباله باشد"

#, python-format
msgid "apidoc_modules item %i '%s' must contain strings"
msgstr "آیتم %i از apidoc_modules، «%s» باید حاوی رشته باشد"

#, python-format
msgid "Would create file %s."
msgstr "پرونده‌ی %s ساخته خواهد شد."

#, python-format
