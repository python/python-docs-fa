msgstr "ساخت با موفقیت انجام شد، %s هشدار."

#, python-format
msgid "node class %r is already registered, its visitors will be overridden"
msgstr "کلاس گره‌ی %r از قبل ثبت شده است؛ بازدیدکنندگان آن بازنویسی خواهند شد"

#, python-format
msgid "directive %r is already registered and will not be overridden"
msgstr "دایرکتیو %r از قبل ثبت شده است و بازنویسی نخواهد شد"

#, python-format
msgid "role %r is already registered and will not be overridden"
msgstr "نقش %r از قبل ثبت شده است و بازنویسی نخواهد شد"

#, python-format
msgid "the %s extension does not declare if it is safe for parallel reading, assuming it isn't - please ask the extension author to check and make it explicit"
msgstr "افزونه‌ی %s اعلام نمی‌کند که آیا برای خواندن موازی ایمن است یا نه؛ فرض بر این است که ایمن نیست — لطفاً از نویسنده‌ی افزونه بخواهید آن را بررسی و صریح کند"

#, python-format
msgid "the %s extension is not safe for parallel reading"
msgstr "افزونه‌ی %s برای خواندن موازی ایمن نیست"

#, python-format
msgid "the %s extension does not declare if it is safe for parallel writing, assuming it isn't - please ask the extension author to check and make it explicit"
msgstr "افزونه‌ی %s اعلام نمی‌کند که آیا برای نوشتن موازی ایمن است یا نه؛ فرض بر این است که ایمن نیست — لطفاً از نویسنده‌ی افزونه بخواهید آن را بررسی و صریحاً اعلام کند"

#, python-format
msgid "the %s extension is not safe for parallel writing"
msgstr "افزونه‌ی %s برای نوشتن موازی ایمن نیست"

#, python-format
msgid "doing serial %s"
msgstr "در حال انجام سریال %s"

#, python-format
msgid "config directory doesn't contain a conf.py file (%s)"
msgstr "پوشه‌ی پیکربندی (%s) شامل یک فایل conf.py نمی‌شود"

msgid "Invalid configuration value found: 'language = None'. Update your configuration to a valid language code. Falling back to 'en' (English)."
msgstr "مقدار پیکربندی نامعتبر یافت شد: 'language = None'. پیکربندی خود را به یک کد زبان معتبر به‌روزرسانی کنید. بازگشت به 'en' (English)."

#, python-format
msgid "'%s' must be '0' or '1', got '%s'"
msgstr "'%s' باید '0' یا '1' باشد، '%s' دریافت شد"

#, python-format
msgid "cannot override dictionary config setting %r, ignoring (use %r to set individual elements)"
msgstr "نمی‌توان تنظیم پیکربندی دیکشنری %r را بازنویسی کرد، نادیده گرفته می‌شود (برای تنظیم عناصر مجزا از %r استفاده کنید)"

#, python-format
msgid "invalid number %r for config value %r, ignoring"
msgstr "عدد نامعتبر %r برای مقدار پیکربندی %r، نادیده گرفته می‌شود"

#, python-format
msgid "cannot override config setting %r with unsupported type, ignoring"
msgstr "نمی‌توان تنظیم پیکربندی %r را با نوع پشتیبانی‌نشده بازنویسی کرد، نادیده گرفته می‌شود"

#, python-format
msgid "unknown config value %r in override, ignoring"
msgstr "مقدار پیکربندی ناشناخته %r در بازنویسی، نادیده گرفته می‌شود"

#, python-format
msgid "No such config value: %r"
msgstr "چنین مقدار پیکربندی وجود ندارد: %r"

#, python-format
msgid "Config value %r already present"
msgstr "مقدار پیکربندی %r از قبل موجود است"

#, python-format
msgid "cannot cache unpickleable configuration value: %r (because it contains a function, class, or module object)"
msgstr "نمی‌توان مقدار پیکربندی پیکل‌ناپذیر را نهان کرد: %r (چون شامل یک تابع، کلاس یا شیء ماژول است)"

#, python-format
msgid "There is a syntax error in your configuration file: %s\n"
msgstr "یک خطای سینتکس در پرونده‌ی پیکربندی شما وجود دارد: %s\n"

msgid "The configuration file (or one of the modules it imports) called sys.exit()"
