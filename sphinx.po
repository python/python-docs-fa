#, python-format
msgid "The %s extension is required by needs_extensions settings, but it is not loaded."
msgstr "افزونه‌ی %s توسط تنظیمات needs_extensions لازم است، اما بار نشده است."

#, python-format
msgid "This project needs the extension %s at least in version %s and therefore cannot be built with the loaded version (%s)."
msgstr "این پروژه به افزونه‌ی %s حداقل در نسخه‌ی %s نیاز دارد و بنابراین نمی‌توان آن را با نسخه‌ی بارشده (%s) ساخت."

#, python-format
msgid "Cannot find source directory (%s)"
msgstr "پوشه‌ی منبع (%s) پیدا نشد"

#, python-format
msgid "Output directory (%s) is not a directory"
msgstr "پوشه‌ی خروجی (%s) یک پوشه نیست"

msgid "Source directory and destination directory cannot be identical"
msgstr "پوشه‌ی منبع و پوشه‌ی مقصد نمی‌توانند یکسان باشند"

#, python-format
msgid "Running Sphinx v%s"
msgstr "در حال اجرای Sphinx نسخه‌ی %s"

#, python-format
msgid "This project needs at least Sphinx v%s and therefore cannot be built with this version."
msgstr "این پروژه حداقل به Sphinx نسخه‌ی %s نیاز دارد و بنابراین نمی‌توان آن را با این نسخه ساخت."

msgid "making output directory"
msgstr "در حال ساخت پوشه‌ی خروجی"

#, python-format
msgid "while setting up extension %s:"
msgstr "هنگام راه‌اندازی افزونه‌ی %s:"

msgid "'setup' as currently defined in conf.py isn't a Python callable. Please modify its definition to make it a callable function. This is needed for conf.py to behave as a Sphinx extension."
msgstr "«setup» به‌شکلی که در حال حاضر در conf.py تعریف شده، یک فراخوانی‌پذیر پایتونی نیست. لطفاً تعریف آن را تغییر دهید تا به یک تابع فراخوانی‌پذیر تبدیل شود. این کار برای اینکه conf.py مانند یک افزونه‌ی Sphinx رفتار کند، لازم است."

#, python-format
msgid "loading translations [%s]... "
msgstr "در حال بارگذاری ترجمه‌ها [%s]... "

msgid "done"
msgstr "انجام شد"

msgid "not available for built-in messages"
msgstr "برای پیام‌های توکار در دسترس نیست"

msgid "loading pickled environment"
msgstr "در حال بارگذاری محیط پیکل‌شده"

#, python-format
msgid "failed: %s"
msgstr "شکست خورد: %s"

msgid "No builder selected, using default: html"
msgstr "هیچ سازنده‌ای انتخاب نشد، استفاده از پیش‌فرض: html"

msgid "build finished with problems."
msgstr "ساخت با مشکلاتی به پایان رسید."

msgid "build succeeded."
msgstr "ساخت با موفقیت به پایان رسید."

msgid "build finished with problems, 1 warning (with warnings treated as errors)."
msgstr "ساخت با مشکلاتی به پایان رسید، ۱ هشدار (با هشدارها به‌عنوان خطا برخورد شده است)."

msgid "build finished with problems, 1 warning."
msgstr "ساخت با مشکلاتی به پایان رسید، ۱ هشدار."

msgid "build succeeded, 1 warning."
msgstr "ساخت با موفقیت به پایان رسید، ۱ هشدار."

#, python-format
msgid "build finished with problems, %s warnings (with warnings treated as errors)."
msgstr "ساخت با مشکلاتی به پایان رسید، %s هشدار (با هشدارها به‌عنوان خطا برخورد شده است)."

#, python-format
msgid "build finished with problems, %s warnings."
msgstr "ساخت با مشکلاتی به پایان رسید، %s هشدار."

#, python-format
msgid "build succeeded, %s warnings."
msgstr "ساخت با موفقیت به پایان رسید، %s هشدار."

#, python-format
msgid "node class %r is already registered, its visitors will be overridden"
msgstr "کلاس گره‌ی %r هم‌اکنون ثبت شده است، بازدیدکننده‌های آن بازنویسی خواهند شد"

#, python-format
msgid "directive %r is already registered and will not be overridden"
msgstr "دایرکتیو %r هم‌اکنون ثبت شده و بازنویسی نخواهد شد"

#, python-format
msgid "role %r is already registered and will not be overridden"
msgstr "رول %r هم‌اکنون ثبت شده و بازنویسی نخواهد شد"

#, python-format
msgid "the %s extension does not declare if it is safe for parallel reading, assuming it isn't - please ask the extension author to check and make it explicit"
msgstr "افزونه‌ی %s مشخص نکرده که برای خواندن موازی امن است یا نه، فرض بر ناامن بودن است - لطفاً از نویسنده‌ی افزونه بخواهید این موضوع را بررسی و صریح کند"

#, python-format
msgid "the %s extension is not safe for parallel reading"
msgstr "افزونه‌ی %s برای خواندن موازی امن نیست"

#, python-format
msgid "the %s extension does not declare if it is safe for parallel writing, assuming it isn't - please ask the extension author to check and make it explicit"
msgstr "افزونه‌ی %s مشخص نکرده که برای نوشتن موازی امن است یا نه، فرض بر ناامن بودن است - لطفاً از نویسنده‌ی افزونه بخواهید این موضوع را بررسی و صریح کند"

#, python-format
msgid "the %s extension is not safe for parallel writing"
msgstr "افزونه‌ی %s برای نوشتن موازی امن نیست"

#, python-format
msgid "doing serial %s"
msgstr "در حال انجام %s به‌صورت سریال"

#, python-format
msgid "config directory doesn't contain a conf.py file (%s)"
msgstr "پوشه‌ی پیکربندی حاوی پرونده‌ی conf.py نیست (%s)"

msgid "Invalid configuration value found: 'language = None'. Update your configuration to a valid language code. Falling back to 'en' (English)."
msgstr "مقدار پیکربندی نامعتبری یافت شد: «language = None». پیکربندی خود را به یک کد زبان معتبر به‌روزرسانی کنید. بازگشت به «en» (انگلیسی)."

#, python-format
msgid "'%s' must be '0' or '1', got '%s'"
msgstr "«%s» باید «۰» یا «۱» باشد، «%s» دریافت شد"

#, python-format
msgid "cannot override dictionary config setting %r, ignoring (use %r to set individual elements)"
msgstr "نمی‌توان تنظیم پیکربندی دیکشنری‌ای %r را بازنویسی کرد، نادیده گرفته شد (برای تنظیم عناصر جداگانه از %r استفاده کنید)"

#, python-format
msgid "invalid number %r for config value %r, ignoring"
msgstr "عدد نامعتبر %r برای مقدار پیکربندی %r، نادیده گرفته شد"

#, python-format
msgid "cannot override config setting %r with unsupported type, ignoring"
msgstr "نمی‌توان تنظیم پیکربندی %r را با نوعی پشتیبانی‌نشده بازنویسی کرد، نادیده گرفته شد"

#, python-format
msgid "unknown config value %r in override, ignoring"
msgstr "مقدار پیکربندی ناشناخته‌ی %r در بازنویسی، نادیده گرفته شد"

#, python-format
msgid "No such config value: %r"
msgstr "چنین مقدار پیکربندی‌ای وجود ندارد: %r"

#, python-format
msgid "Config value %r already present"
msgstr "مقدار پیکربندی %r هم‌اکنون وجود دارد"

#, python-format
msgid "cannot cache unpickleable configuration value: %r (because it contains a function, class, or module object)"
msgstr "نمی‌توان مقدار پیکربندی پیکل‌ناپذیر %r را در نهانگاه ذخیره کرد (چون حاوی یک تابع، کلاس یا شیء ماژول است)"

#, python-format
msgid "There is a syntax error in your configuration file: %s\n"
msgstr "خطای نحوی در پرونده‌ی پیکربندی شما وجود دارد: %s\n"

msgid "The configuration file (or one of the modules it imports) called sys.exit()"
msgstr "پرونده‌ی پیکربندی (یا یکی از ماژول‌هایی که ایمپورت می‌کند) تابع ()sys.exit را فراخوانی کرد"

#, python-format
msgid ""
"There is a programmable error in your configuration file:\n"
"\n"
"%s"
msgstr ""
"خطایی برنامه‌ای در پرونده‌ی پیکربندی شما وجود دارد:\n"
"\n"
"%s"

#, python-format
msgid "Failed to convert %r to a frozenset"
msgstr "تبدیل %r به frozenset شکست خورد"

#, python-format
msgid "Converting `source_suffix = %r` to `source_suffix = %r`."
msgstr "در حال تبدیل «source_suffix = %r» به «source_suffix = %r»."

#, python-format
msgid "The config value `source_suffix' expects a dictionary, a string, or a list of strings. Got `%r' instead (type %s)."
msgstr "مقدار پیکربندی «source_suffix» انتظار یک دیکشنری، رشته یا فهرستی از رشته‌ها را دارد. به‌جای آن «%r» (نوع %s) دریافت شد."

#, python-format
msgid "Section %s"
msgstr "بخش %s"

#, python-format
msgid "Fig. %s"
msgstr "شکل %s"

#, python-format
msgid "Table %s"
msgstr "جدول %s"

#, python-format
msgid "Listing %s"
msgstr "لیستینگ %s"

#, python-brace-format
msgid "The config value `{name}` has to be a one of {candidates}, but `{current}` is given."
msgstr "مقدار پیکربندی «{name}» باید یکی از {candidates} باشد، اما «{current}» داده شده است."

#, python-brace-format
msgid "The config value `{name}' has type `{current.__name__}'; expected {permitted}."
msgstr "مقدار پیکربندی «{name}» از نوع «{current.__name__}» است؛ {permitted} انتظار می‌رفت."

#, python-brace-format
msgid "The config value `{name}' has type `{current.__name__}', defaults to `{default.__name__}'."
msgstr "مقدار پیکربندی «{name}» از نوع «{current.__name__}» است و مقدار پیش‌فرض آن «{default.__name__}» است."

#, python-format
msgid "primary_domain %r not found, ignored."
msgstr "primary_domain %r پیدا نشد، نادیده گرفته شد."

msgid "Sphinx now uses \"index\" as the master document by default. To keep pre-2.0 behaviour, set \"master_doc = 'contents'\"."
msgstr "Sphinx اکنون به‌طور پیش‌فرض از «index» به‌عنوان سند اصلی استفاده می‌کند. برای حفظ رفتار پیش از نسخه‌ی ۲.۰، مقدار «master_doc = 'contents'» را تنظیم کنید."

#, python-format
msgid "Pygments lexer name %r is not known"
msgstr "نام لکسر Pygments با نام %r شناخته‌شده نیست"

#, python-format
msgid "Lexing literal_block %r as \"%s\" resulted in an error at token: %r. Retrying in relaxed mode."
msgstr "لکسینگ literal_block با نام %r به‌صورت «%s» در توکن %r به خطا انجامید. تلاش دوباره در حالت آزاد."

#, python-format
msgid "Theme configuration sections other than [theme] and [options] are not supported (tried to get a value from %r)."
msgstr "بخش‌های پیکربندی پوسته غیر از [theme] و [options] پشتیبانی نمی‌شوند (تلاش برای دریافت مقدار از %r)."

#, python-format
msgid "setting %s.%s occurs in none of the searched theme configs"
msgstr "تنظیم %s.%s در هیچ‌کدام از پیکربندی‌های پوسته‌ی جست‌وجوشده وجود ندارد"

#, python-format
msgid "unsupported theme option %r given"
msgstr "گزینه‌ی پشتیبانی‌نشده‌ی پوسته‌ی %r داده شد"

#, python-format
msgid "file %r on theme path is not a valid zipfile or contains no theme"
msgstr "پرونده‌ی %r در مسیر پوسته یک زیپ‌فایل معتبر نیست یا حاوی هیچ پوسته‌ای نیست"

#, python-format
msgid "no theme named %r found (missing theme.toml?)"
msgstr "هیچ پوسته‌ای با نام %r پیدا نشد (theme.toml گم شده؟)"

#, python-format
msgid "The %r theme has circular inheritance"
msgstr "پوسته‌ی %r دارای وراثت چرخه‌ای است"

#, python-format
msgid "The %r theme inherits from %r, which is not a loaded theme. Loaded themes are: %s"
msgstr "پوسته‌ی %r از %r ارث‌بری می‌کند که پوسته‌ای بارشده نیست. پوسته‌های بارشده عبارت‌اند از: %s"

#, python-format
msgid "The %r theme has too many ancestors"
msgstr "پوسته‌ی %r اجداد بیش از حد زیادی دارد"

#, python-format
msgid "no theme configuration file found in %r"
msgstr "هیچ پرونده‌ی پیکربندی پوسته‌ای در %r پیدا نشد"

#, python-format
msgid "theme %r doesn't have the \"theme\" table"
msgstr "پوسته‌ی %r جدول «theme» را ندارد"

#, python-format
msgid "The %r theme \"[theme]\" table is not a table"
msgstr "جدول «[theme]» در پوسته‌ی %r یک جدول نیست"

#, python-format
msgid "The %r theme must define the \"theme.inherit\" setting"
msgstr "پوسته‌ی %r باید تنظیم «theme.inherit» را تعریف کند"

#, python-format
msgid "The %r theme \"[options]\" table is not a table"
msgstr "جدول «[options]» در پوسته‌ی %r یک جدول نیست"

#, python-format
msgid "The \"theme.pygments_style\" setting must be a table. Hint: \"%s\""
msgstr "تنظیم «theme.pygments_style» باید یک جدول باشد. راهنمایی: «%s»"

#, python-format
msgid "Event %r already present"
msgstr "رویداد %r هم‌اکنون وجود دارد"

#, python-format
msgid "Unknown event name: %s"
msgstr "نام رویداد ناشناخته: %s"

#, python-format
msgid "Handler %r for event %r threw an exception"
msgstr "هندلر %r برای رویداد %r استثنایی پرتاب کرد"

#, python-format
msgid ""
"multiple files found for the document \"%s\": %s\n"
"Use %r for the build."
msgstr ""
"چندین پرونده برای سند «%s» پیدا شد: %s\n"
"برای ساخت از %r استفاده کنید."

#, python-format
msgid "Ignored unreadable document %r."
msgstr "سند غیرقابل‌خواندن %r نادیده گرفته شد."

#, python-format
msgid "Builder class %s has no \"name\" attribute"
msgstr "کلاس سازنده‌ی %s ویژگی «name» ندارد"

#, python-format
msgid "Builder %r already exists (in module %s)"
msgstr "سازنده‌ی %r هم‌اکنون وجود دارد (در ماژول %s)"

#, python-format
msgid "Builder name %s not registered or available through entry point"
msgstr "نام سازنده‌ی %s ثبت نشده یا از طریق نقطه‌ی ورود در دسترس نیست"

#, python-format
msgid "Builder name %s not registered"
msgstr "نام سازنده‌ی %s ثبت نشده است"

#, python-format
msgid "domain %s already registered"
msgstr "دامنه‌ی %s هم‌اکنون ثبت شده است"

#, python-format
msgid "domain %s not yet registered"
msgstr "دامنه‌ی %s هنوز ثبت نشده است"

#, python-format
msgid "The %r directive is already registered to domain %s"
msgstr "دایرکتیو %r هم‌اکنون در دامنه‌ی %s ثبت شده است"

#, python-format
msgid "The %r role is already registered to domain %s"
msgstr "رول %r هم‌اکنون در دامنه‌ی %s ثبت شده است"

#, python-format
msgid "The %r index is already registered to domain %s"
msgstr "اندیس %r هم‌اکنون در دامنه‌ی %s ثبت شده است"

#, python-format
msgid "The %r object_type is already registered"
msgstr "object_type با نام %r هم‌اکنون ثبت شده است"

#, python-format
msgid "The %r crossref_type is already registered"
msgstr "crossref_type با نام %r هم‌اکنون ثبت شده است"

#, python-format
msgid "source_suffix %r is already registered"
msgstr "source_suffix با نام %r هم‌اکنون ثبت شده است"

#, python-format
msgid "source_parser for %r is already registered"
msgstr "source_parser برای %r هم‌اکنون ثبت شده است"

#, python-format
msgid "Source parser for %s not registered"
msgstr "پارسر منبع برای %s ثبت نشده است"

#, python-format
msgid "Translator for %r already exists"
msgstr "مترجم برای %r هم‌اکنون وجود دارد"

#, python-format
msgid "kwargs for add_node() must be a (visit, depart) function tuple: %r=%r"
msgstr "آرگومان‌های کلیدواژه‌ای ()add_node باید یک تاپل تابعی (visit, depart) باشد: %r=%r"

#, python-format
msgid "enumerable_node %r already registered"
msgstr "enumerable_node با نام %r هم‌اکنون ثبت شده است"

#, python-format
msgid "math renderer %s is already registered"
msgstr "رندرکننده‌ی ریاضی %s هم‌اکنون ثبت شده است"

#, python-format
msgid "the extension %r was already merged with Sphinx since version %s; this extension is ignored."
msgstr "افزونه‌ی %r از نسخه‌ی %s با Sphinx ادغام شده است؛ این افزونه نادیده گرفته می‌شود."

msgid "Original exception:\n"
msgstr "استثنای اصلی:\n"

#, python-format
msgid "Could not import extension %s"
msgstr "ایمپورت افزونه‌ی %s ممکن نشد"

#, python-format
msgid "extension %r has no setup() function; is it really a Sphinx extension module?"
msgstr "افزونه‌ی %r تابع ()setup ندارد؛ آیا این واقعاً یک ماژول افزونه‌ی Sphinx است؟"

#, python-format
msgid "The %s extension used by this project needs at least Sphinx v%s; it therefore cannot be built with this version."
msgstr "افزونه‌ی %s که این پروژه استفاده می‌کند حداقل به Sphinx نسخه‌ی %s نیاز دارد؛ بنابراین نمی‌توان آن را با این نسخه ساخت."

#, python-format
msgid "extension %r returned an unsupported object from its setup() function; it should return None or a metadata dictionary"
msgstr "افزونه‌ی %r شیئی پشتیبانی‌نشده از تابع ()setup خود بازگرداند؛ باید None یا دیکشنری فراداده بازگرداند"

#, python-format
msgid "`None` is not a valid filetype for %r."
msgstr "«None» نوع پرونده‌ی معتبری برای %r نیست."

#, python-format
msgid "Common Vulnerabilities and Exposures; CVE %s"
msgstr "آسیب‌پذیری‌ها و افشاگری‌های عمومی؛ CVE %s"

#, python-format
msgid "invalid CVE number %s"
msgstr "شماره‌ی CVE نامعتبر %s"

#, python-format
msgid "Common Weakness Enumeration; CWE %s"
msgstr "فهرست ضعف‌های عمومی؛ CWE %s"

#, python-format
msgid "invalid CWE number %s"
msgstr "شماره‌ی CWE نامعتبر %s"

#, python-format
msgid "Python Enhancement Proposals; PEP %s"
msgstr "پیشنهادهای بهبود پایتون؛ PEP %s"

#, python-format
msgid "invalid PEP number %s"
msgstr "شماره‌ی PEP نامعتبر %s"

#, python-format
msgid "invalid RFC number %s"
msgstr "شماره‌ی RFC نامعتبر %s"

msgid "[source]"
msgstr "نمایش منبع"

msgid "highlighting module code... "
msgstr "در حال برجسته‌سازی کد ماژول... "

msgid "[docs]"
msgstr "[مستندات]"

msgid "Module code"
msgstr "کد ماژول"

#, python-format
msgid "<h1>Source code for %s</h1>"
msgstr "<h1>کد منبع برای %s</h1>"

msgid "Overview: module code"
msgstr "بررسی اجمالی: کد ماژول"

msgid "<h1>All modules for which code is available</h1>"
msgstr "<h1>تمام ماژول‌هایی که کد آن‌ها در دسترس است</h1>"

#, python-format
msgid "hardcoded link %r could be replaced by an extlink (try using %r instead)"
msgstr "پیوند سخت‌کدشده‌ی %r می‌تواند با یک extlink جایگزین شود (به‌جای آن از %r استفاده کنید)"

#, python-format
msgid "section \"%s\" gets labeled as \"%s\""
msgstr "بخش «%s» با برچسب «%s» علامت‌گذاری می‌شود"

