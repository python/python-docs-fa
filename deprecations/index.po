msgstr ":c:func:`!_PyUnicodeWriter_PrepareKind`: (بدون جایگزین)."

msgid ":c:func:`!_Py_HashPointer`: use :c:func:`Py_HashPointer`."
msgstr ":c:func:`!_Py_HashPointer`: از :c:func:`Py_HashPointer` استفاده کنید."

msgid ":c:func:`!_Py_fopen_obj`: use :c:func:`Py_fopen`."
msgstr ":c:func:`!_Py_fopen_obj`: از :c:func:`Py_fopen` استفاده کنید."

msgid ""
"The `pythoncapi-compat project <https://github.com/python/pythoncapi-"
